<resources>
    <!-- The framework has no Theme.Material.DayNight; Theme.DeviceDefault.DayNight
         is API 29 and OEM-skinned, and AppCompat is not a dependency of this SDK.
         Two qualified copies of one name give the payment window a dark background
         under night mode from minSdk 24, matching what PayCrossTheme draws inside. -->
    <style name="Theme.PayCross.Payment" parent="@android:style/Theme.Material.Light.NoActionBar" />
</resources>
